{
  "name": "mindbird/contao-room-reservation",
  "description": "Simple room reservation bundle",
  "minimum-stability": "stable",
  "license": "LGPL-3.0-or-later",
  "keywords": [
    "contao",
    "room",
    "reservation"
  ],
  "type": "contao-bundle",
  "authors": [
    {
      "name": "mindbird",
      "email": "info@mindbird.de"
    }
  ],
  "require": {
    "php": "^8.3",
    "contao/core-bundle": "^5.7",
    "contao/calendar-bundle": "^5.7",
    "contao/manager-plugin": "^2.0",
    "terminal42/notification_center": "^2.7"
  },
  "autoload": {
    "psr-4": {
      "Mindbird\\Contao\\RoomReservation\\": "src/"
    }
  },
  "extra": {
    "contao-manager-plugin": "Mindbird\\Contao\\RoomReservation\\ContaoManager\\Plugin"
  },
  "config": {
    "allow-plugins": {
      "contao-components/installer": true,
      "contao/manager-plugin": true
    }
  },
  "prefer-stable": true,
  "support": {
    "issues": "https://github.com/mindbird/contao-room-reservation/issues",
    "source": "https://github.com/mindbird/contao-room-reservation"
  }
}
