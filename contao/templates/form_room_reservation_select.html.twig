{% extends '@Contao/form_row.html.twig' %}

{% block label %}
    <div class="formElement">
        {% if this.label %}
            <label for="ctrl_{{ this.id }}"{% if this.class|default %} class="{{ this.class|default }}"{% endif %}>
                {% if this.mandatory|default %}
                    <span class="invisible">{{ this.mandatoryField }} </span>{{ this.label|insert_tag_raw }}<span class="mandatory">*</span>
                {% else %}
                    {{ this.label|insert_tag_raw }}
                {% endif %}
            </label>
        {% endif %}
{% endblock %}

{% block field %}
    {% if this.multiple|default %}
        <input type="hidden" name="{{ this.name ends with '[]' ? this.name[:-2] : this.name }}" value="">
    {% endif %}

    <select{{ attrs()
        .set('name', this.name)
        .set('id', "ctrl_#{this.id}")
        .addClass(this.class|default)
        .mergeWith(getAttributes.invoke())
    }}>
        {% for option in getOptions.invoke() %}
            {% if option.type == 'group_start' %}
                <optgroup label="{{ option.label }}">
            {% endif %}

            {% if option.type == 'option' %}
                <option value="{{ option.value }}"{{ option.selected|raw }}>{{ option.label|insert_tag_raw }}</option>
            {% endif %}

            {% if option.type == 'group_end' %}
                </optgroup>
            {% endif %}
        {% endfor %}
    </select>
    <div class="error">{{ getErrorAsString.invoke() }}</div>
    </div>
{% endblock %}
